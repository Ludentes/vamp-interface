index c6f465c..5117919 100644
--- a/train_stage_1.py
+++ b/train_stage_1.py
@@ -16,6 +16,19 @@ import torch
 import torch.nn as nn
 import torch.nn.functional as F
 import torch.utils.checkpoint
+# torch 2.11: Moore custom_forward(*inputs) closures don't accept kwargs.
+# Bind kwargs into a lambda + call non-reentrant checkpoint positional-only.
+_orig_ckpt = torch.utils.checkpoint.checkpoint
+_ckpt_kwarg_names = {"use_reentrant","context_fn","determinism_check","debug","early_stop"}
+def _ckpt_compat(fn, *args, **kw):
+    ck_kwargs = {k: kw.pop(k) for k in list(kw) if k in _ckpt_kwarg_names}
+    ck_kwargs.setdefault("use_reentrant", False)
+    if kw:
+        user_kw = kw
+        bound = lambda *a, **_unused: fn(*a, **user_kw)
+        return _orig_ckpt(bound, *args, **ck_kwargs)
+    return _orig_ckpt(fn, *args, **ck_kwargs)
+torch.utils.checkpoint.checkpoint = _ckpt_compat
 import transformers
 from accelerate import Accelerator
 from accelerate.logging import get_logger
